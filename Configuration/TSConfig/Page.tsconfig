@import 'EXT:ps14_foundation/Configuration/TSConfig/Page.tsconfig'

mod.wizards.newContentElement.wizardItems {
	common {
		elements {
			ps14_icon_text {
				iconIdentifier = ps14-module-icon-text
				title = SKETCH
				description = SKETCH_DESCRIPTION
				tt_content_defValues {
					CType = ps14_site_sketch
				}
			}
		}

		show := addToList(ps14_site_sketch)
	}
}

TCEFORM {
	tt_content {
		frame_class {
			removeItems = ruler-before, ruler-after, indent, indent-left, indent-right, none, primary
			addItems {
				primary-600 = LLL:EXT:ps14_site/Resources/Private/Language/locallang_tca.xlf:tt_content.hue.primary-600
				secondary-100 = LLL:EXT:ps14_site/Resources/Private/Language/locallang_tca.xlf:tt_content.hue.secondary-100
				secondary-800 = LLL:EXT:ps14_site/Resources/Private/Language/locallang_tca.xlf:tt_content.hue.secondary-800
			}
		}
	}
}

[field('CType') === 'ps14_icon_text']
	TCEFORM {
		tt_content {
			tx_foundation_variant {
				addItems {
					media-left = Media Left
				}
			}
		}
	}
[END]

[field('CType') === 'text']
	TCEFORM {
		tt_content {
			tx_foundation_variant {
				addItems {
					media-left = Media Left
					media-right = Media Right
				}
			}
		}
	}
[END]