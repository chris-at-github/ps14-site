// Backend layout with additional footer column (colPos 20), activate if needed:
// @import 'EXT:ps14_foundation/Configuration/TsConfig/Page/BackendLayouts/DefaultFooter.tsconfig'

TCAdefaults.tt_content {
  space_before_class.types.div = large
  space_after_class.types.div = large
}

TCEFORM.tt_content {
  imageborder.types.image.disabled = 1
}

TCEFORM.pages.tx_foundation_navigation_layout.addItems {
  card = LLL:EXT:ps14_site/Resources/Private/Language/locallang_tca.xlf:pages.navigation-layout.card
}
